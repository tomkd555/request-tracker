{
  "name": "request-tracker",
  "version": "0.6.2",
  "description": "Request tracker for a small team over a shared folder",
  "main": "./out/main/index.js",
  "author": "TOMKD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomkd555/request-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/tomkd555/request-tracker/issues"
  },
  "homepage": "https://github.com/tomkd555/request-tracker#readme",
  "keywords": [
    "electron",
    "issue-tracker",
    "request-tracker",
    "shared-folder",
    "japanese"
  ],
  "private": true,
  "scripts": {
    "dev": "electron-vite dev -w",
    "dev:second": "electron-vite dev -w -- --user-data-dir=.second-userdata",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "notices": "node scripts/third-party-notices.mjs > THIRD-PARTY-NOTICES.txt",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
