# ルート直下は、下で許可したもの以外をすべて無視する（公開するのはインストール集合だけ）
/*
!/.gitignore
!/LICENSE
!/README.md
!/THIRD-PARTY-NOTICES.txt
!/package.json
!/package-lock.json
!/electron-builder.yml
!/electron.vite.config.ts
!/tsconfig.json
!/tsconfig.node.json
!/tsconfig.web.json
!/scripts/
!/src/

# 公開するフォルダーの中のテスト
tests/
__tests__/
*.test.*
*.spec.*

node_modules/
out/
dist/
.second-userdata/
*.log
.env*
coverage/
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
.codegraph/
